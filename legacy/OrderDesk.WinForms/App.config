<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!-- Strangler flag: false = original ADO.NET path, true = call the Spring Boot API -->
    <add key="UseModernApi" value="false" />
    <add key="ModernApiBaseUrl" value="http://localhost:8080" />
  </appSettings>
  <connectionStrings>
    <!-- Legacy smell: credentials in config on every desktop. Fixed in Scenario 16 (Windows auth / API + Entra ID). -->
    <add name="OrderDesk" connectionString="Server=localhost,1433;Database=orderdesk;User Id=sa;Password=OrderDesk!Pass123;TrustServerCertificate=True" />
  </connectionStrings>
</configuration>
